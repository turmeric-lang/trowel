// Generated by CMake from cmake/build_info.h.in — do not edit.
//
// This header exists for two reasons, and the second one is load-bearing.
//
// 1. It is the single source of truth for the versions Trowel reports, so the
//    app version tracks the VERSION file instead of a hand-edited literal.
//
// 2. Including it from a source file ties the `trowel` target's build to
//    TROWEL_TURMERIC_VERSION. The bundled toolchain is staged into the app by
//    a POST_BUILD command, and POST_BUILD only runs when the target is
//    actually rebuilt. Bumping the toolchain version alone would otherwise
//    re-download it into _deps, leave the *previous* one staged in the bundle,
//    and report "ninja: no work to do" — an incremental build would silently
//    keep shipping the old `tur`. Regenerating this header on a bump forces
//    the recompile that forces the relink that reruns the staging.
#pragma once

#define TROWEL_VERSION_STRING "@TROWEL_VERSION@"

// The Turmeric release staged inside the app bundle. Empty when no prebuilt
// matched the host and Trowel falls back to `tur` on PATH.
#define TROWEL_BUNDLED_TURMERIC_VERSION "@TROWEL_BUNDLED_TURMERIC@"

// The Turmeric version Trowel is built against (e.g. "v0.62.0"), used for
// documentation links and the About dialog.
#define TROWEL_TURMERIC_VERSION "@TROWEL_TURMERIC_VERSION@"

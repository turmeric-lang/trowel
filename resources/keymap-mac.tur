;; Bundled keymap for macOS.
;; This file is loaded at startup before ~/.trowel/keymap.tur.
;; User overrides in ~/.trowel/keymap.tur take precedence.
;;
;; Each line maps a command id to keyboard shortcut(s).
;; Command ids are slugified from menu text (spaces removed,
;; other punctuation becomes hyphens).
;; Multiple shortcuts for a command are passed as extra arguments.

(trowel-set-keybinding "trowel.new" "Ctrl+N")
(trowel-set-keybinding "trowel.newwindow" "Ctrl+Shift+N")
(trowel-set-keybinding "trowel.open" "Ctrl+O")
(trowel-set-keybinding "trowel.opendirectory" "Ctrl+Shift+O")
(trowel-set-keybinding "trowel.closetab" "Ctrl+W")
(trowel-set-keybinding "trowel.closewindow" "Ctrl+Shift+W")
(trowel-set-keybinding "trowel.save" "Ctrl+S")
(trowel-set-keybinding "trowel.saveas" "Ctrl+Shift+S")
(trowel-set-keybinding "trowel.quit" "Ctrl+Q")
(trowel-set-keybinding "trowel.undo" "Ctrl+Z")
(trowel-set-keybinding "trowel.redo" "Ctrl+Shift+Z")
(trowel-set-keybinding "trowel.cut" "Ctrl+X")
(trowel-set-keybinding "trowel.copy" "Ctrl+C")
(trowel-set-keybinding "trowel.paste" "Ctrl+V")
(trowel-set-keybinding "trowel.selectall" "Ctrl+A")
(trowel-set-keybinding "trowel.togglecomment" "Ctrl+/")
(trowel-set-keybinding "trowel.indent" "Ctrl+]")
(trowel-set-keybinding "trowel.outdent" "Ctrl+[")
(trowel-set-keybinding "trowel.formatfile" "Ctrl+Shift+Alt+F")
(trowel-set-keybinding "trowel.completesymbol" "Meta+Space")
(trowel-set-keybinding "trowel.showdocumentation" "Ctrl+Shift+D")
(trowel-set-keybinding "trowel.showsignaturehelp" "Ctrl+Shift+P")
(trowel-set-keybinding "trowel.renamesymbol" "F2")
(trowel-set-keybinding "trowel.settings" "Ctrl+,")
(trowel-set-keybinding "trowel.find" "Ctrl+F")
(trowel-set-keybinding "trowel.findandreplace" "Ctrl+Alt+F")
(trowel-set-keybinding "trowel.findnext" "Ctrl+G")
(trowel-set-keybinding "trowel.findprevious" "Ctrl+Shift+G")
(trowel-set-keybinding "trowel.useselectionforfind" "Ctrl+E")
(trowel-set-keybinding "trowel.selectalloccurrences" "Meta+Ctrl+G")
(trowel-set-keybinding "trowel.showrepl" "Ctrl+Alt+R")
(trowel-set-keybinding "trowel.wordwrap" "Alt+Z")
(trowel-set-keybinding "trowel.minimap" "Alt+M")
(trowel-set-keybinding "trowel.zoomin" "Ctrl+=")
(trowel-set-keybinding "trowel.zoomout" "Ctrl+-")
(trowel-set-keybinding "trowel.actualsize" "Ctrl+0")
(trowel-set-keybinding "trowel.nexttab" "Ctrl+Shift+]" "Meta+Tab")
(trowel-set-keybinding "trowel.previoustab" "Ctrl+Shift+[" "Meta+Shift+Tab")
(trowel-set-keybinding "trowel.enterfullscreen" "Meta+Ctrl+F")
(trowel-set-keybinding "trowel.fold" "Alt+Ctrl+[")
(trowel-set-keybinding "trowel.unfold" "Alt+Ctrl+]")
(trowel-set-keybinding "trowel.togglefold" "Ctrl+K, Ctrl+L")
(trowel-set-keybinding "trowel.foldall" "Ctrl+K, Ctrl+0")
(trowel-set-keybinding "trowel.unfoldall" "Ctrl+K, Ctrl+J")
(trowel-set-keybinding "trowel.foldtop-levelforms" "Ctrl+K, Ctrl+1")
(trowel-set-keybinding "trowel.gotodefinition" "F12")
(trowel-set-keybinding "trowel.findreferences" "Shift+F12")
(trowel-set-keybinding "trowel.showsymbols" "Ctrl+Shift+M")
(trowel-set-keybinding "trowel.findsymbolinproject" "Ctrl+Shift+J")
(trowel-set-keybinding "trowel.gotoline" "Ctrl+L")
(trowel-set-keybinding "trowel.goback" "Meta+-")
(trowel-set-keybinding "trowel.goforward" "Meta+Shift+-")
(trowel-set-keybinding "trowel.runbuffer" "Ctrl+R")
(trowel-set-keybinding "trowel.runselection" "Ctrl+Shift+E")
(trowel-set-keybinding "trowel.tracebuffer" "Ctrl+Shift+T")
(trowel-set-keybinding "trowel.debugbuffer" "F5")
(trowel-set-keybinding "trowel.time-traveldebug" "Ctrl+F5")
(trowel-set-keybinding "trowel.restartdebugsession" "Ctrl+Shift+F5")
(trowel-set-keybinding "trowel.togglebreakpoint" "F9")
(trowel-set-keybinding "trowel.restartrepl" "Ctrl+Shift+R")
(trowel-set-keybinding "trowel.clearrepl" "Ctrl+Shift+K")
(trowel-set-keybinding "trowel.minimize" "Ctrl+M")
(trowel-set-keybinding "trowel.focuseditor" "Ctrl+Alt+E")
(trowel-set-keybinding "trowel.focusrepl" "Ctrl+T")
(trowel-set-keybinding "trowel.togglerepl-editorfocus" "Meta+`")
